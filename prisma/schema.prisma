// Prisma schema for Samya By Samishtha e-commerce site

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String
  price         Int // price in paise (INR) to avoid float issues; store as rupees*100
  compareAtPrice Int?
  images        String // JSON-encoded array of image URLs
  stock         Int         @default(0)
  sku           String?     @unique
  isFeatured    Boolean     @default(false)
  isGiftable    Boolean     @default(false)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0) // lower shows first in the default "Featured" sort
  material      String?
  category      Category    @relation(fields: [categoryId], references: [id])
  categoryId    String
  orderItems    OrderItem[]
  reviews       Review[]
  variants      ProductVariant[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ProductVariant {
  id            String      @id @default(cuid())
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  attributeName String      @default("Color") // "Color" or "Size"
  label         String // e.g. "Red", "Antique Gold", "2.4 inch"
  images        String // JSON-encoded array of image URLs for this variant
  stock         Int         @default(0)
  sku           String?     @unique
  sortOrder     Int         @default(0)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  state         String
  pincode       String
  notes         String?
  subtotal      Int
  discount      Int         @default(0)
  codCharge     Int         @default(0)
  giftTotal     Int         @default(0)
  couponCode    String?
  total         Int
  status        String      @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  paymentMethod String      @default("COD") // COD or RAZORPAY
  paymentStatus String      @default("PENDING") // PENDING, PAID, FAILED
  razorpayOrderId   String?
  razorpayPaymentId String?
  trackingNumber   String? // Delhivery waybill number
  shippingProvider String? // e.g. "Delhivery"
  shippingStatus   String? // Manifested, Failed, etc.
  shippingError    String? // last error message, if shipment creation failed
  items         OrderItem[]
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  password  String
  address   String?
  city      String?
  state     String?
  pincode   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id           String          @id @default(cuid())
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  product      Product?        @relation(fields: [productId], references: [id])
  productId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId    String?
  variantLabel String?
  name         String
  price        Int
  quantity     Int
  image        String?
  giftCharge   Int             @default(0)
  giftNote     String?
}

model OrderCounter {
  id    String @id
  value Int
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String    @default("PERCENT") // PERCENT or FLAT
  value         Int // percent (0-100) or flat amount in paise, depending on type
  minOrderValue Int       @default(0) // paise
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  usageLimit    Int? // null = unlimited
  usedCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  country   String?
  region    String?
  city      String?
  referrer  String?
  eventType String   @default("pageview")
  meta      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([country])
  @@index([eventType])
}

model Review {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  orderId      String?
  customerName String
  email        String
  rating       Int // 1-5
  comment      String
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String
  content         String // HTML
  coverImage      String
  tags            String // comma-separated
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  author          String   @default("Samya By Samishtha")
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
